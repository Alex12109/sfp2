---
import type { LinkRef, Lang } from '../lib/types';
import { t } from '../i18n/ui';
interface Props { crumbs?: LinkRef[]; lang: Lang; current?: string }
const { crumbs = [], lang, current } = Astro.props;
---
{crumbs.length > 0 && (
  <nav class="crumbs" aria-label={t(lang).breadcrumb}>
    <ol>
      {crumbs.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
      {current && <li aria-current="page" set:html={current} />}
    </ol>
  </nav>
)}
