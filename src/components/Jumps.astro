---
import type { Section, Lang } from '../lib/types';
import { pad } from '../lib/content';
interface Props { s: Section; lang: Lang }
const { s } = Astro.props;
---
<nav class="jumps tone-ivory" aria-label="Inhalt">
  <ul class="wrap">
    {(s.actions ?? []).map((a, i) => <li><a href={a.href}>{a.label}</a></li>)}
  </ul>
</nav>
