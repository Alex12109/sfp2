# Anfrageweg:
#   live  – Standard: ein Knopf „Anfrage senden“, POST (JSON) an PUBLIC_ENQUIRY_ENDPOINT
#   draft – früherer Weg: E-Mail-Entwurf / Kopie / Download, kein Versand
#   demo  – sichtbar gekennzeichneter Mock, kein Versand
PUBLIC_ENQUIRY_MODE=live
# Standard: /api/enquiry (gleicher Host). Solange dort nichts antwortet, zeigt das Formular
# eine Fehlermeldung mit dem Ausweg „Stattdessen per E-Mail senden“.
PUBLIC_ENQUIRY_ENDPOINT=/api/enquiry
