# Anfrageweg:
#   draft – Standard: E-Mail-Entwurf / Kopie / Download, kein Versand
#   demo  – sichtbar gekennzeichneter Mock, kein Versand
#   live  – sendet per POST (JSON) an PUBLIC_ENQUIRY_ENDPOINT
PUBLIC_ENQUIRY_MODE=draft
# Nur für live. Beispiel bei gleichem Host: /api/enquiry
PUBLIC_ENQUIRY_ENDPOINT=
